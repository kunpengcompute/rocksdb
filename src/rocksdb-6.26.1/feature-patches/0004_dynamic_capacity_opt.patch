diff --git a/db/version_set.cc b/db/version_set.cc
index 5d9adf4b3..28ba5514e 100644
--- a/db/version_set.cc
+++ b/db/version_set.cc
@@ -20,6 +20,10 @@
 #include <unordered_map>
 #include <vector>
 
+#ifdef __ARM_FEATURE_SVE
+#include <arm_sve.h>
+#endif
+
 #include "compaction/compaction.h"
 #include "db/blob/blob_fetcher.h"
 #include "db/blob/blob_file_cache.h"
@@ -1737,6 +1741,7 @@ VersionStorageInfo::VersionStorageInfo(
       user_comparator_(user_comparator),
       // cfd is nullptr if Version is dummy
       num_levels_(levels),
+      num_levels_in_use_(1),
       num_non_empty_levels_(0),
       file_indexer_(user_comparator),
       compaction_style_(compaction_style),
@@ -3672,7 +3677,51 @@ void VersionStorageInfo::CalculateBaseBytes(const ImmutableOptions& ioptions,
   level_max_bytes_.resize(ioptions.num_levels);
   if (!ioptions.level_compaction_dynamic_level_bytes) {
     base_level_ = (ioptions.compaction_style == kCompactionStyleLevel) ? 1 : -1;
+#if defined(__ARM_FEATURE_SVE)
+    constexpr int LANES = 4;
+    int total = num_levels_ -1;  // levels to scan: [1, num_levels_)
+
+    for (int base = 0; base < total; base += LANES) {
+      int remaining = total - base;
+      // Predicate: activate min(remaining,4) lanes
+      svbool_t pg = svwhilelt_b64(0, remaining);
+
+      // level numbers for this iteration: [base+1, base+2, base+3, base+4]
+      svuint64_t level_ids = svadd_u64_z(pg, svindex_u64(base + 1, 1), svdup_u64(0));
 
+      size_t sizes[LANES] = {0};
+      for (int level_i = base; level_i < base + LANES; level_i++) {
+        sizes[level_i - base] = files_[level_i + 1].size();
+      }
+      svuint64_t vec_sizes = svld1(pg, &(sizes[base]));
+      // Track whether each level has found a non-zero-file-size entry
+      svbool_t nonzero = svcmpgt_u64(pg, vec_sizes, svdup_u64(0));
+
+      // Merge: for lanes that  found a non-zero file, keep level number;
+      //        for others, set  to 0. Then take max across lanes.
+      svuint64_t masked_ids = svsel_u64(nonzero, level_ids, svdup_u64(0));
+      uint64_t best = svmaxv_u64(pg, masked_ids);
+      if (best > 0) {
+        num_levels_in_use_ = static_cast<int>(best);
+      } 
+    }
+
+    double autumn_base_scale = 
+        std::min(1.0, std::pow(options.autumn_c, num_levels_in_use_ - 1));
+    // Calculate for static  bytes base case
+    level_max_bytes_[0] = options.max_bytes_for_level_base;
+    for (int i = 1; i < ioptions.num_levels; ++i) {
+      if (i > 1){
+        level_max_bytes_[i] = MultiplyCheckOverflow(
+            MultiplyCheckOverflow(level_max_bytes_[i - 1],
+                                  options.max_bytes_for_level_multiplier / autumn_base_scale),
+            options.MaxBytesMultiplerAdditional(i - 1));
+      }else{
+        level_max_bytes_[i] = static_cast<uint64_t>(options.max_bytes_for_level_base / autumn_base_scale);
+      }
+      autumn_base_scale = std::min(1.0, autumn_base_scale / options.autumn_c);
+    }
+#else
     // Calculate for static bytes base case
     for (int i = 0; i < ioptions.num_levels; ++i) {
       if (i == 0 && ioptions.compaction_style == kCompactionStyleUniversal) {
@@ -3685,7 +3734,9 @@ void VersionStorageInfo::CalculateBaseBytes(const ImmutableOptions& ioptions,
       } else {
         level_max_bytes_[i] = options.max_bytes_for_level_base;
       }
+
     }
+#endif
   } else {
     uint64_t max_level_size = 0;
 
