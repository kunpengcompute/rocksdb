+
 TEST_F(VersionStorageInfoTest, MaxBytesForLevelStatic) {
   ioptions_.level_compaction_dynamic_level_bytes = false;
   mutable_cf_options_.max_bytes_for_level_base = 10;
   mutable_cf_options_.max_bytes_for_level_multiplier = 5;
+  mutable_cf_options_.autumn_c = 1.0;
   Add(4, 100U, "1", "2");
-  Add(5, 101U, "1", "2");
 
   vstorage_.CalculateBaseBytes(ioptions_, mutable_cf_options_);
   ASSERT_EQ(vstorage_.MaxBytesForLevel(1), 10U);
   ASSERT_EQ(vstorage_.MaxBytesForLevel(2), 50U);
   ASSERT_EQ(vstorage_.MaxBytesForLevel(3), 250U);
   ASSERT_EQ(vstorage_.MaxBytesForLevel(4), 1250U);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(5), 6250U);
+
+  mutable_cf_options_.autumn_c = 0.8;
+  vstorage_.CalculateBaseBytes(ioptions_, mutable_cf_options_);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(1), 19U);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(2), 148U);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(3), 925U);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(4), 4625U);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(5), 23125U);
+
+  Add(5, 101U, "1", "2");
+  vstorage_.CalculateBaseBytes(ioptions_, mutable_cf_options_);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(1), 24U);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(2), 234U);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(3), 1828U);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(4), 11425U);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(5), 57125U);
+
+  ASSERT_EQ(0, logger_->log_count);
+}
+
+TEST_F(VersionStorageInfoUniversalTest, AutumnCDoesNotAffectMaxBytes) {
+  ioptions_.level_compaction_dynamic_level_bytes = false;
+  mutable_cf_options_.max_bytes_for_level_base = 10;
+  mutable_cf_options_.max_bytes_for_level_multiplier = 5;
+  mutable_cf_options_.autumn_c = 0.8;
+  Add(4, 100U, "1", "2");
 
+  vstorage_.CalculateBaseBytes(ioptions_, mutable_cf_options_);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(0), 10U);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(1), 10U);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(2), 50U);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(3), 250U);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(4), 1250U);
+  ASSERT_EQ(vstorage_.MaxBytesForLevel(5), 6250U);
   ASSERT_EQ(0, logger_->log_count);
 }
 
