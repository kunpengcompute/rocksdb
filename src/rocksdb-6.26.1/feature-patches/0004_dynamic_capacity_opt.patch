diff --git a/db/version_set.cc b/db/version_set.cc
index 5d9adf4b3..8f0fd5a3a 100644
--- a/db/version_set.cc
+++ b/db/version_set.cc
@@ -12,6 +12,7 @@
 #include <algorithm>
 #include <array>
 #include <cinttypes>
+#include <cmath>
 #include <cstdio>
 #include <list>
 #include <map>
@@ -1737,6 +1738,7 @@ VersionStorageInfo::VersionStorageInfo(
       user_comparator_(user_comparator),
       // cfd is nullptr if Version is dummy
       num_levels_(levels),
+      num_levels_in_use_(1),
       num_non_empty_levels_(0),
       file_indexer_(user_comparator),
       compaction_style_(compaction_style),
@@ -3672,18 +3674,41 @@ void VersionStorageInfo::CalculateBaseBytes(const ImmutableOptions& ioptions,
   level_max_bytes_.resize(ioptions.num_levels);
   if (!ioptions.level_compaction_dynamic_level_bytes) {
     base_level_ = (ioptions.compaction_style == kCompactionStyleLevel) ? 1 : -1;
+    double autumn_base_scale = 1.0;
+    if (compaction_style_ == kCompactionStyleLevel) {
+      num_levels_in_use_ = 1;
+      for (int i = 1; i < num_levels_; ++i) {
+        if (!files_[i].empty()) {
+          num_levels_in_use_ = i;
+        }
+      }
 
+      autumn_base_scale =
+          std::pow(options.autumn_c, num_levels_in_use_ - 1);
+      if (!std::isfinite(autumn_base_scale) || autumn_base_scale <= 0.0) {
+        autumn_base_scale = 1.0;
+      }
+    }
     // Calculate for static bytes base case
-    for (int i = 0; i < ioptions.num_levels; ++i) {
-      if (i == 0 && ioptions.compaction_style == kCompactionStyleUniversal) {
-        level_max_bytes_[i] = options.max_bytes_for_level_base;
-      } else if (i > 1) {
+    level_max_bytes_[0] = options.max_bytes_for_level_base;
+    for (int i = 1; i < ioptions.num_levels; ++i) {
+      if (i > 1) {
         level_max_bytes_[i] = MultiplyCheckOverflow(
-            MultiplyCheckOverflow(level_max_bytes_[i - 1],
-                                  options.max_bytes_for_level_multiplier),
+            MultiplyCheckOverflow(
+                level_max_bytes_[i - 1],
+                options.max_bytes_for_level_multiplier / autumn_base_scale),
             options.MaxBytesMultiplerAdditional(i - 1));
       } else {
-        level_max_bytes_[i] = options.max_bytes_for_level_base;
+        level_max_bytes_[i] = MultiplyCheckOverflow(
+            options.max_bytes_for_level_base, 1.0 / autumn_base_scale);
+      }
+      if (compaction_style_ == kCompactionStyleLevel) {
+        autumn_base_scale /= options.autumn_c;
+        if (!std::isfinite(autumn_base_scale) || autumn_base_scale <= 0.0) {
+          autumn_base_scale = 1.0;
+        } else {
+          autumn_base_scale = std::min(1.0, autumn_base_scale);
+        }
       }
     }
   } else {
