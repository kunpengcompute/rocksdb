+static inline uint64_t sve2_scalar_to_num(uint64_t varint_part)
+{
+  const uint64_t extract_mask = 0x0000000F7F7F7F7FULL;
+
+  svuint64_t sv_data   = svdup_u64(varint_part);
+  svuint64_t sv_mask   = svdup_u64(extract_mask);
+  svuint64_t sv_result = svbext_u64(sv_data, sv_mask);
+
+  return svlastb_u64(svptrue_b64(), sv_result);
+}
+
+const char *GetVarint32PtrFallback_sve2(const char *p, const char *limit, uint32_t *value)
+{
+  if (limit - p < 8) {
+    return GetVarint32PtrFallback(p, limit, value);
+  }
+
+  const uint64_t *ptr = (const uint64_t *)p;
+  const uint64_t mask_0x7f = 0x7F7F7F7F7F7F7F7FULL;
+  uint64_t msbs = ~ptr[0] & ~mask_0x7f;
+  if (msbs == 0) {
+    return GetVarint32PtrFallback(p, limit, value);
+  }
+
+  const size_t first_stop_bit = static_cast<size_t>(__builtin_ctzll(msbs));
+  const size_t len = (first_stop_bit >> 3) + 1;
+  if (len > 5) {
+    return GetVarint32PtrFallback(p, limit, value);
+  }
+
+  uint64_t mask = msbs ^ (msbs - 1);
+  uint64_t varint_part = ptr[0] & mask;
+
+  *value = (uint32_t)sve2_scalar_to_num(varint_part);
+  p += len;
+  return p;
+}
+#endif
